# heybot 配置
#
# 优先级：进程环境变量 > 本文件 > 内置默认值。
# 所以临时调试可以 `HEYBOT_POLL_SECONDS=5 heybot watch` 覆盖单项。
#
# 本文件含凭据，务必收紧权限：chmod 600 .env

# ── AI 接口（OpenAI 兼容）────────────────────────────────
HEYBOT_AI_BASE_URL=https://api.openai.com/v1
HEYBOT_AI_API_KEY=
HEYBOT_AI_MODEL=gpt-4o-mini
# 可选
# HEYBOT_AI_TIMEOUT_SECONDS=60
# HEYBOT_AI_MAX_TOKENS=500
# HEYBOT_AI_TEMPERATURE=0.8

# ── 监听行为 ─────────────────────────────────────────────
# 轮询间隔（秒），5~600
HEYBOT_POLL_SECONDS=20
# 同时进行的 AI 生成数（1~16）。接口调用由客户端节流器限速，并发不会打爆。
HEYBOT_CONCURRENCY=4
# 单轮最多处理多少条新消息（1~200）。超出的留到下一轮。
HEYBOT_MAX_PER_ROUND=20
# 「目标评论查不到」重试多少次后才认定它真被删了（1~20）。
HEYBOT_TARGET_MISSING_RETRIES=5

# ── 本地文件路径（一般不用改）─────────────────────────────
# HEYBOT_WATERMARK_FILE=   # 水位线文件路径
# HEYBOT_HOME=            # 一次性指定项目根目录
# HEYBOT_PROMPT_DIR=      # 一次性指定 prompt 模板目录
